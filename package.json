{
  "name": "fafa-desktop-pet",
  "version": "0.3.0",
  "description": "发发 - 支持 B 站直播互动的 Windows 桌面宠物",
  "type": "module",
  "main": "src/main/main.js",
  "author": "Fafa",
  "license": "UNLICENSED",
  "scripts": {
    "dev:web": "vite --host 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:5173/pet.html && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "dev": "concurrently -k \"pnpm dev:web\" \"pnpm dev:electron\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:web": "vite build",
    "build": "pnpm test && pnpm build:web && electron-builder --win nsis --x64",
    "build:test": "pnpm test && pnpm run build:web && electron-builder --dir --win --x64 --config.directories.output=test-build-v030 --config.electronDist=node_modules/electron/dist",
    "build:portable": "pnpm run build:web && electron-builder --dir --win --x64 --config.directories.output=portable-v0.3.0 --config.electronDist=node_modules/electron/dist",
    "check": "node scripts/check-javascript.mjs",
    "validate:actions": "node scripts/validate-action-videos.mjs",
    "validate:actions:release": "node scripts/validate-action-videos.mjs --release"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.2",
    "bilibili-live-ws": "^6.3.1",
    "electron-store": "^10.0.1",
    "node-global-key-listener": "0.3.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.0",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "tailwindcss": "4.1.0",
    "vite": "^6.2.3",
    "vitest": "^3.0.9",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.fafa.desktop-pet",
    "productName": "发发",
    "asar": true,
    "files": [
      "dist/**/*",
      "src/main/**/*",
      "src/preload/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "models",
        "to": "models",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "**/node_modules/@huggingface/transformers/**/*",
      "**/node_modules/onnxruntime-node/**/*",
      "**/node_modules/onnxruntime-web/**/*",
      "**/node_modules/node-global-key-listener/**/*"
    ],
    "directories": {
      "output": "release-v0.3.0"
    },
    "win": {
      "icon": "public/assets/fafa-pet-final.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "发发",
      "deleteAppDataOnUninstall": false
    }
  }
}
